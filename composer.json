{
    "name": "janalis/doctrineviz",
    "description": "Generate Graphviz DOT diagrams from a Doctrine DBAL database schema.",
    "type": "symfony-bundle",
    "license": "BSD-3-Clause",
    "keywords": [
        "doctrine",
        "dbal",
        "schema",
        "graphviz",
        "symfony-bundle"
    ],
    "homepage": "https://github.com/janalis/doctrineviz",
    "support": {
        "issues": "https://github.com/janalis/doctrineviz/issues",
        "source": "https://github.com/janalis/doctrineviz"
    },
    "require": {
        "php": "^8.5",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.0",
        "janalis/viz": "^0.2.1",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.57",
        "infection/infection": "^0.35.8",
        "phpunit/phpunit": "^12.5",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/process": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Janalis\\Doctrineviz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Janalis\\Doctrineviz\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "format": "mago fmt",
        "format:check": "mago fmt --check",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=var/coverage/clover.xml --coverage-xml=var/coverage/xml --log-junit=var/coverage/junit.xml",
        "infection": "infection --threads=max",
        "verify": [
            "@composer validate --strict",
            "@format:check",
            "@lint",
            "@analyze",
            "@test"
        ]
    }
}
